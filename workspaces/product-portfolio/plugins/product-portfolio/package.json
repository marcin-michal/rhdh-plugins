{
  "name": "@red-hat-developer-hub/backstage-plugin-product-portfolio",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Catalog-native Product Portfolio frontend",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./alpha": "./src/alpha.tsx",
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "alpha": [
        "src/alpha.tsx"
      ],
      "package.json": [
        "package.json"
      ]
    }
  },
  "backstage": {
    "role": "frontend-plugin",
    "pluginId": "product-portfolio",
    "supported-versions": "1.49.4",
    "pluginPackages": [
      "@red-hat-developer-hub/backstage-plugin-product-portfolio",
      "@red-hat-developer-hub/backstage-plugin-product-portfolio-common",
      "@red-hat-developer-hub/backstage-plugin-pyxis-common"
    ]
  },
  "scripts": {
    "build": "backstage-cli package build",
    "lint": "backstage-cli package lint",
    "test": "backstage-cli package test",
    "clean": "backstage-cli package clean",
    "prepack": "backstage-cli package prepack",
    "postpack": "backstage-cli package postpack"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@backstage/catalog-model": "1.7.7",
    "@backstage/core-components": "0.18.8",
    "@backstage/core-plugin-api": "1.12.4",
    "@backstage/frontend-plugin-api": "0.15.1",
    "@backstage/plugin-catalog": "2.0.1",
    "@backstage/plugin-catalog-react": "2.1.1",
    "@backstage/ui": "0.13.2",
    "@material-ui/core": "^4.12.2",
    "@red-hat-developer-hub/backstage-plugin-product-portfolio-common": "workspace:^",
    "@red-hat-developer-hub/backstage-plugin-pyxis-common": "workspace:^"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-router-dom": "^6.0.0"
  },
  "devDependencies": {
    "@backstage/cli": "0.36.0",
    "@backstage/frontend-test-utils": "0.5.1",
    "@backstage/test-utils": "1.7.16",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.4"
  },
  "jest": {
    "testEnvironment": "<rootDir>/../../../scripts/jest-environment.cjs",
    "setupFilesAfterEnv": [
      "<rootDir>/setupTests.ts"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/redhat-developer/rhdh-plugins",
    "directory": "workspaces/product-portfolio/plugins/product-portfolio"
  },
  "publishConfig": {
    "access": "public"
  }
}
